# Generate local secrets with: python deploy/generate_env.py
# Blank secrets are deliberate. Compose refuses selected services until filled.
# Keep .env private. Only deploy/compose.yml is needed for the Studio profile.
STUDIO_API_TOKEN=
STUDIO_ENV=production
STUDIO_DB_PATH=data/studio.db
STUDIO_ENABLE_LIVE=false
STUDIO_MODEL=studio-model
# For container Studio. For a host-run Studio use http://127.0.0.1:4000/v1.
STUDIO_LITELLM_BASE_URL=http://litellm:4000/v1
STUDIO_LITELLM_API_KEY=
# Opt-in only: http://collector:4318/v1/traces in Compose;
# host-run Studio uses http://127.0.0.1:4318/v1/traces.
STUDIO_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true

# Proxy profile only: never a provider credential in source control.
LITELLM_MASTER_KEY=
LITELLM_PROVIDER_MODEL=
OPENAI_API_KEY=

# Phoenix profile. Initial password is only used when creating its admin account.
PHOENIX_SECRET=
PHOENIX_ADMIN_PASSWORD=
# Create a system API key in Phoenix after login. Not the UI password.
PHOENIX_API_KEY=

# Langfuse profile: hex passwords avoid URI escaping issues in DATABASE_URL.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
# Exactly 64 hexadecimal characters (32 bytes).
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_S3_ACCESS_KEY=
LANGFUSE_S3_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Base64(public_key:secret_key), without a newline or the literal 'Basic ' prefix.
LANGFUSE_BASIC_AUTH=
